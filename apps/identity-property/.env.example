PORT=4001
MONGODB_URI=mongodb://atithisafe:atithisafe@localhost:27017/identity_property?authSource=admin

# Must match the gateway. Signs staff and guest tokens.
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h

# Shared secret the gateway and other services send in x-internal-api-key.
INTERNAL_API_KEY=change-me-internal

# Traveller app base URL; QR codes point to <GUEST_APP_URL>/welcome?qr=<code>
GUEST_APP_URL=http://localhost:3000

# First AtithiSafe operator, created only when the users collection is empty.
SEED_OPERATOR_EMAIL=operator@atithisafe.local
SEED_OPERATOR_PASSWORD=change-me-please
