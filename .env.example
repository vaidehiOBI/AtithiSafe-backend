# Shared values used by docker-compose
MONGO_USER=atithisafe
MONGO_PASSWORD=atithisafe
JWT_SECRET=change-me
INTERNAL_API_KEY=change-me-internal
GUEST_APP_URL=http://localhost:3000
SEED_OPERATOR_EMAIL=operator@atithisafe.local
SEED_OPERATOR_PASSWORD=change-me-please

# Used when running the NestJS services directly with npm. Give each service
# its own database. Replace these examples with your Atlas connection details.
IDENTITY_PROPERTY_MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/identity_property?retryWrites=true&w=majority&appName=atithisafe
SAFETY_OPERATIONS_MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/safety_operations?retryWrites=true&w=majority&appName=atithisafe
COMMUNICATION_PROVIDER_MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/communication_provider?retryWrites=true&w=majority&appName=atithisafe
