{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "identity-property": {
      "type": "application",
      "root": "apps/identity-property",
      "entryFile": "main",
      "sourceRoot": "apps/identity-property/src",
      "compilerOptions": {
        "tsConfigPath": "apps/identity-property/tsconfig.app.json"
      }
    },
    "safety-operations": {
      "type": "application",
      "root": "apps/safety-operations",
      "entryFile": "main",
      "sourceRoot": "apps/safety-operations/src",
      "compilerOptions": {
        "tsConfigPath": "apps/safety-operations/tsconfig.app.json"
      }
    },
    "communication-provider": {
      "type": "application",
      "root": "apps/communication-provider",
      "entryFile": "main",
      "sourceRoot": "apps/communication-provider/src",
      "compilerOptions": {
        "tsConfigPath": "apps/communication-provider/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}
